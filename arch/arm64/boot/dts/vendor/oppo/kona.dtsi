// kona.dtsi
/ {
    mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x1 0x40000000 0x0 0x40000000>,
				<0x1 0xc0000000 0x0 0x80000000>,
				<0x2 0xc0000000 0x1 0x40000000>;
		granule = <512>;
		mboxes = <&qmp_aop 0>;
	};

    /* #ifdef OPLUS_ARCH_EXTENDS */
    aliases {
		i2c2 = &qupv3_se15_i2c;
    };
    /* #endif OPLUS_ARCH_EXTENDS */

    chosen {
		bootargs = "rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kasan_multi_shot";
	};

    midas_pdev {
		compatible = "oplus,midas-pdev";
	};

    // kona-thermal.dtsi
    //#ifdef OPLUS_FEATURE_THERMAL_HORAE
    shell_front {
        compatible = "oplus,shell-temp";
    };

    shell_frame {
        compatible = "oplus,shell-temp";
    };

    shell_back {
        compatible = "oplus,shell-temp";
    };
    //#endif
};

&firmware {
    android {
        //#ifndef OPLUS_BUG_STABILITY
        vbmeta {
            parts = "vbmeta,boot,system,vendor,dtbo,recovery";
        };

        fstab {
            vendor {
                fsmgr_flags = "wait,avb";
            };
        };
        //#endif /* OPLUS_BUG_STABILITY */
    };
};

&reserved_memory {
    // #ifdef OPLUS_BUG_STABILITY
    /* Add for get current xlb_uefi log, add reserved size 2M for kernelboot xbl uefis*/
    // xbl_uefi_mem address get from boot_images Core.dsc.inc file: PcdEmbeddedFdBaseAddress + SERIAL_BUFFER_OFFSET,0x9FE00000+0x1F7000=0x9FFF7000
    // kernel boot log: 0x9FE00000~ 0x9FFF7000
    kboot_uboot_logmem: kboot_uboot_logmem@0x9FE00000 {
        reg = <0x0 0x9FE00000 0x0 0x200000>;
        compatible = "oplus,xbl_uefi_kbootlog";
        xbluefi-offset = <0x1F7000>;
        no-map;
    };
    // #endif

    disp_rdump_memory: disp_rdump_region@9c000000 {
        reg = <0x0 0x9c000000 0x0 0x00800000>;
        label = "disp_rdump_region";
    };

    // #ifdef OPLUS_FEATURE_DUMPDEVICE
    ramoops: ramoops@0xB0000000 {
        compatible = "ramoops";
        reg = <0 0xB0000000 0 0x00400000>;
        record-size = <0x40000>;
        console-size = <0x40000>;
        ftrace-size = <0x40000>;
        pmsg-size = <0x200000>;
        devinfo-size = <0x01000>;
        ecc-size = <0x0>;
    };
    // #endif
};

&soc {
    /delete-node/ ufsice@1d90000;

    mem_dump {
        /delete-node/ osm_reg;
        /delete-node/ pcu_reg;
        /delete-node/ fsm_data;
    };
};

&reserved_xbl_uefi_log {
    status = "disabled";
};

&removed_mem {
    reg = <0x0 0x80b00000 0x0 0xcd00000>;
};

&pil_camera_mem {
    reg = <0x0 0x8dc00000 0x0 0x500000>;
};

&pil_wlan_fw_mem {
    reg = <0x0 0x8e100000 0x0 0x100000>;
};

&pil_ipa_fw_mem {
    reg = <0x0 0x8e200000 0x0 0x10000>;
};

&pil_ipa_gsi_mem {
    reg = <0x0 0x8e210000 0x0 0xa000>;
};

&pil_gpu_mem {
    reg = <0x0 0x8e21a000 0x0 0x2000>;
};

&pil_npu_mem {
    reg = <0x0 0x8e300000 0x0 0x500000>;
};

&pil_video_mem {
    reg = <0x0 0x8e800000 0x0 0x500000>;
};

&pil_cvp_mem {
    reg = <0x0 0x8ed00000 0x0 0x500000>;
};

&pil_cdsp_mem {
    reg = <0x0 0x8f200000 0x0 0x1400000>;
};

&pil_slpi_mem {
    reg = <0x0 0x90600000 0x0 0x1500000>;
};

&pil_adsp_mem {
    reg = <0x0 0x91b00000 0x0 0x2500000>;
};

&pil_spss_mem {
    reg = <0x0 0x94000000 0x0 0x100000>;
};

&cdsp_secure_heap {
    reg = <0x0 0x94100000 0x0 0x4600000>;
};

//ifdef OPLUS_BUG_STABILITY
//add for raising bark-time
&wdog {
    qcom,bark-time = <22000>;
};
//endif /*OPLUS_BUG_STABILITY*/

&qcom_seecom {
    reg = <0x82400000 0xb400000>;
};

&clock_aop {
    /delete-property/ qcom,clk-stop-bimc-log;
};

&ufs_phy_gdsc {
    /delete-property/ qcom,gds-timeout;
};

&gpu_gx_gdsc {
    /delete-property/ qcom,skip-disable-before-sw-enable;
};

&spss_utils {
    qcom,pil-addr = <0x94000000>;
};

&wlan {
    /delete-property/ qcom,bt-en-gpio;
    /delete-property/ qcom,sw-ctrl-gpio;
    /delete-property/ qcom,converged-dt;

    //#ifdef OPLUS_ARCH_EXTENDS
    /delete-property/ qcom,cmd_db_name;
    //#endif /* OPLUS_ARCH_EXTENDS */

    //#ifdef OPLUS_BUG_COMPATIBILITY
    use-nv-mac;
    //#endif /* OPLUS_BUG_COMPATIBILITY */

    //#ifdef OPLUS_ARCH_EXTENDS
    /delete-property/ vdd-wlan-dig-supply;
    /delete-property/ qcom,vdd-wlan-dig-config;
    /delete-property/ wlan-ant-switch-supply;
    /delete-property/ qcom,wlan-ant-switch-config;
    //#endif /* OPLUS_ARCH_EXTENDS */

    mhi_channels {
        /delete-node/ mhi_event@2;
    };
};

&qfprom {
    reg = <0x00784000 0x3000>;

    /delete-node/ gpu_lm_efuse@45c8;
    /delete-node/ gpu_speed_bin@419b;
    /delete-node/ thermal-speed-bin@1a2;

    gpu_lm_efuse: gpu_lm_efuse@5c8 {
        reg = <0x5c8 0x4>;
    };

    gpu_speed_bin: gpu_speed_bin@19b {
        reg = <0x19b 0x1>;
        bits = <5 3>;
    };
};

// kona-audio.dtsi
/* #ifdef OPLUS_ARCH_EXTENDS */
&dai_mi2s2 {
    qcom,msm-mi2s-rx-lines = <2>;
    qcom,msm-mi2s-tx-lines = <1>;
};
/* #endif OPLUS_ARCH_EXTENDS */

/* #ifdef OPLUS_ARCH_EXTENDS */
&qupv3_se15_i2c {
    /delete-node/ fsa4480@43;

    fsa4480: fsa4480@42 {
		compatible = "qcom,fsa4480-i2c";
		reg = <0x42>;
		pinctrl-names = "default";
		pinctrl-0 = <&fsa_hs_det>;
		fsa4480,hs-det-gpio = <&tlmm 11 0x00>;
	};
};

&tlmm {
	fsa_hs_det: fsa_hs_det  {
		mux {
			pins = "gpio11";
			function = "gpio";
		};

		config {
			pins = "gpio11";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};
};
/* #endif OPLUS_ARCH_EXTENDS */

// kona-qupv3.dtsi
&soc {
    /delete-node/ qcom,qup_uart@a94000;
};

//#ifdef /* OPLUS_FEATURE_CHG_BASIC */
&qupv3_se16_i2c {
    pinctrl-names = "default", "sleep", "pulldown", "pullup";
    pinctrl-2 = <&qupv3_se16_i2c_pulldown>;
    pinctrl-3 = <&qupv3_se16_i2c_pullup>;
};
//#endif /* OPLUS_FEATURE_CHG_BASIC */

// kona-camera.dtsi
/*#ifdef OPLUS_FEATURE_EDIT*/
&i2c_freq_400Khz_cci0 {
    hw-scl-stretch-en = <1>;
};

&i2c_freq_1Mhz_cci0 {
    hw-scl-stretch-en = <1>;
};

&i2c_freq_400Khz_cci1 {
    hw-scl-stretch-en = <1>;
};

&i2c_freq_1Mhz_cci1 {
    hw-scl-stretch-en = <1>;
};

&cam_vfe0 {
    qcom,iommu-faults = "non-fatal";
};

&cam_vfe1 {
    qcom,iommu-faults = "non-fatal";
};

&cam_vfe_lite0 {
    qcom,iommu-faults = "non-fatal";
};

&cam_vfe_lite1 {
    qcom,iommu-faults = "non-fatal";
};
/*#endif*/

// kona-pcie.dtsi
//#ifdef OPLUS_BUG_STABILITY
&pcie1 {
    /* Add for disable pcie1 */
    status = "disabled";  
};
//#endif /* OPLUS_BUG_STABILITY */

// kona-pinctrl.dtsi
&tlmm {
    /* #ifdef OPLUS_ARCH_EXTENDS */
    /delete-node/ tert_aux_pcm;
    /delete-node/ tert_aux_pcm_din;
    /delete-node/ tert_aux_pcm_dout;

    /delete-node/ tert_tdm_din;
    /delete-node/ tert_tdm_dout;
    /* #endif OPLUS_ARCH_EXTENDS */

    /delete-node/ qupv3_se13_4uart_pins;

    /*#ifdef VENDOR_EDIT */
    /delete-node/ cam_sensor_active_4;
    /delete-node/ cam_sensor_suspend_4;
    /delete-node/ cam_sensor_active_5;
    /delete-node/ cam_sensor_suspend_5;
    /delete-node/ cam_sensor_active_6;
    /delete-node/ cam_sensor_suspend_6;
    /*endif*/

    //#ifdef OPLUS_FEATURE_FINGERPRINT
    oplus_fp_common {
        gpio_id2_default: gpio_id2_default {
            mux {
                pins = "gpio9";
                function = "gpio";
            };

            config {
                pins = "gpio9";
                drive-strength = <2>;
                bias-pull-up;
                input-enable;
            };
        };
    };

    goodix_fp {
        gpio_goodix_irq_default: gpio_goodix_irq_default {
            mux {
                pins = "gpio23";
                function = "gpio";
            };

            config {
                pins = "gpio23";
                drive-strength = <2>;
                bias-disable;
                input-enable;
            };
        };
    };

    jiiov_fp{
		gpio_anc_reset_reset: gpio_anc_reset_reset {
			mux {
				pins = "gpio68";
				function = "gpio";
			};
			config {
				pins = "gpio68";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};

		gpio_anc_reset_active: gpio_anc_reset_active {
			mux {
				pins = "gpio68";
				function = "gpio";
			};
			config {
				pins = "gpio68";
				drive-strength = <2>;
				bias-disable;
				output-high;
			};
		};

		gpio_anc_irq_active: gpio_anc_irq_active {
			mux {
				pins = "gpio23";
				function = "gpio";
			};
			config {
				pins = "gpio23";
				drive-strength = <2>;
				bias-pull-down;
			};
		};
	};
    //#endif /*OPLUS_FEATURE_FINGERPRINT*/

    //#ifdef OPLUS_FEATURE_TP_BASIC
    /* add pingrp for touchscreen */
    pmx_ts_int_active_oppo {
        ts_int_active: ts_int_active {
            mux {
                pins = "gpio39";
                function = "gpio";
            };

            config {
                pins = "gpio39";
                drive-strength = <2>;
                bias-disable;
            };
        };
    };

    pmx_ts_int_suspend_oppo {
        ts_int_suspend1: ts_int_suspend1 {
            mux {
                pins = "gpio39";
                function = "gpio";
            };

            config {
                pins = "gpio39";
                drive-strength = <2>;
                bias-disable;
            };
        };
    };

    pmx_ts_reset_active_oppo {
        ts_reset_active: ts_reset_active {
            mux {
                pins = "gpio38";
                function = "gpio";
            };

            config {
                pins = "gpio38";
                drive-strength = <2>;
                output-low;
                bias-disable;
            };
        };
    };

    pmx_ts_reset_suspend_oppo {
        ts_reset_suspend1: ts_reset_suspend1 {
            mux {
                pins = "gpio38";
                function = "gpio";
            };

            config {
                pins = "gpio38";
                drive-strength = <2>;
                output-low;
                bias-disable;
            };
        };
    };
    //#endif /*OPLUS_FEATURE_TP_BASIC*/

    //#ifdef VENDOR_EDIT
    pmx_sde {
        panel_vout_active: panel_vout_active {
            mux {
                pins = "gpio8";
                function = "gpio";
            };

            config {
                pins = "gpio8";
                drive-strength = <8>;
                bias-disable = <0>;   /* no pull */
            };
        };

        panel_vout_suspend: panel_vout_suspend {
            mux {
                pins = "gpio8";
                function = "gpio";
            };

            config {
                pins = "gpio8";
                drive-strength = <2>;
                bias-pull-down;
            };
        };
    };
    //#endif

    /* #if defined(CONFIG_PXLW_IRIS5) */
