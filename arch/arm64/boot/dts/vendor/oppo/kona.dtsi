// kona-regulators.dtsi
//#ifdef OPLUS_FEATURE_EDIT
&apps_rsc {
    rpmh-regulator-ldoa14 {
        regulator-pm8150-l14 {
            regulator-min-microvolt = <1650000>;
        };
    };

    rpmh-regulator-ldoc2 {
        regulator-pm8150a-l2 {
            regulator-min-microvolt = <1120000>;
            qcom,init-voltage = <1152000>;
        };
    };

    rpmh-regulator-ldoc7 {
        regulator-pm8150a-l7 {
            regulator-min-microvolt = <2800000>;
            qcom,init-voltage = <2800000>;
        };
    };

    rpmh-regulator-ldoc11 {
        regulator-pm8150a-l11 {
            regulator-min-microvolt = <2900000>;
            qcom,init-voltage = <3000000>;
        };
    };

    rpmh-regulator-ldof1 {
        regulator-pm8009-l1 {
            regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1100000>;
			qcom,init-voltage = <1100000>;
        };
    };

    rpmh-regulator-ldof2 {
        regulator-pm8009-l2 {
            regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1100000>;
			qcom,init-voltage = <1100000>;
        };
    };

    rpmh-regulator-ldof3 {
        regulator-pm8009-l3 {
            regulator-min-microvolt = <1050000>;
			regulator-max-microvolt = <1050000>;
			qcom,init-voltage = <1050000>;
        };
    };

    rpmh-regulator-ldof4 {
		compatible = "qcom,rpmh-vrm-regulator";
		qcom,resource-name = "ldof4";
		qcom,regulator-type = "pmic5-ldo";
		qcom,supported-modes =
			<RPMH_REGULATOR_MODE_LPM
			 RPMH_REGULATOR_MODE_HPM>;
		qcom,mode-threshold-currents = <0 30000>;
		L4F: pm8009_l4: regulator-pm8009-l4 {
			regulator-name = "pm8009_l4";
			qcom,set = <RPMH_REGULATOR_SET_ALL>;
			regulator-min-microvolt = <1050000>;
			regulator-max-microvolt = <1050000>;
			qcom,init-voltage = <1050000>;
			qcom,init-mode = <RPMH_REGULATOR_MODE_LPM>;
		};
	};
};
//#endif /*OPLUS_FEATURE_EDIT*/

// kona-usb.dtsi
//#ifdef OPLUS_FEATURE_CHG_BASIC
&usb0 {
    qcom,pm-qos-latency = <61>; /* CUP0-WFI-LVL latency +1 */
};

&usb1 {
    status = "disabled";
};

&usb2_phy1 {
    qcom,param-override-seq = <0x66 0x6c
                            0x2d 0x70
                            0x1c 0x74
                            0x00 0x78>;
    qcom,param-override-seq-host = <0x66 0x6c
                            0x2d 0x70
                            0x1c 0x74
                            0x00 0x78>;
};
//#endif
