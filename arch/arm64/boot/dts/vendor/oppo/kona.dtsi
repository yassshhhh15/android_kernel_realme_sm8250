        vooc_asic_id_sleep: vooc_asic_id_sleep {
            mux {
                pins = "gpio64";
                function = "gpio";
            };

            config {
                pins = "gpio64";
                drive-strength = <2>;
                bias-pull-down;
                input-enable;
            };
        };

        charge_pump_hwid_active: charge_pump_hwid_active {
            mux {
                pins = "gpio33";
                function = "gpio";
            };

            config {
                pins = "gpio33";
                drive-strength = <2>;
                bias-pull-up;
                input-enable;
            };
        };

        charge_pump_hwid_sleep: charge_pump_hwid_sleep {
            mux {
                pins = "gpio33";
                function = "gpio";
            };

            config {
                pins = "gpio33";
                drive-strength = <2>;
                bias-pull-down;
                input-enable;
            };
        };

        charge_pump_hwid_default: charge_pump_hwid_default {
            mux {
                pins = "gpio33";
                function = "gpio";
            };

            config {
                pins = "gpio33";
                drive-strength = <2>;
                bias-pull-down;
            };
        };
    };

    //#ifdef OPLUS_FEATURE_TP_BASIC
    rf_cable0_active: rf_cable0_active {
        mux {
            pins = "gpio84";
            function = "gpio";
        };

        config {
            pins = "gpio84";
            drive-strength = <2>;
            input-enable;
            bias-pull-up;
        };
    };
    //#endif /* OPLUS_FEATURE_TP_BASIC */

    /*#ifdef VENDOR_EDIT */
    pm8008_interrupt: pm8008_interrupt {
        mux {
            pins = "gpio63";
            function = "gpio";
        };

        config {
            pins = "gpio63";
            bias-disable;
            input-enable;
        };
    };

    pm8008_active: pm8008_active {
        mux {
            pins = "gpio112";
            function = "gpio";
        };

        config {
            pins = "gpio112";
            bias-pull-up;
            output-high;
            drive-strength = <2>;
        };
    };
    /*endif*/
};

&qupv3_se12_2uart_active {
    config {
        bias-pull-down;
    };
};

&qupv3_se12_2uart_sleep {
    mux {
        drive-strength = <2>;
    };

    config {
        /delete-property/ bias-pull-down;
        input-enable;
        bias-disable;
    };
};

