            function = "gpio";
        };

        config {
            pins = "gpio74";
            bias-disable; /* No PULL */
            drive-strength = <2>; /* 2 MA */
        };
    };
    /*endif*/

    qupv3_se16_i2c_pins {
        qupv3_se16_i2c_pulldown: qupv3_se16_i2c_pulldown {
            mux {
                pins = "gpio48", "gpio49";
                function = "gpio";
            };

            config {
                pins = "gpio48", "gpio49";
                drive-strength = <2>;
                bias-pull-down;
                output-low;
            };
        };

        qupv3_se16_i2c_pullup: qupv3_se16_i2c_pullup {
            mux {
                pins = "gpio48", "gpio49";
                function = "gpio";
            };

            config {
                pins = "gpio48", "gpio49";
                drive-strength = <2>;
                bias-pull-up;
                input-enable;
            };
        };
    };

    //#ifdef OPLUS_FEATURE_CHG_BASIC//Qingjun.Wang@BSP.Haptic,add 2020/03/17 for vib aw8697
    aw_haptics: aw_haptics {
        aw_irq_gpio_default: aw_irq_gpio_default {
            mux {
                pins = "gpio47";
                function = "gpio";
            };

            config {
                pins = "gpio47";
                drive-strength = <2>;
                input-enable;
                bias-pull-up; /* PULL UP */
            };
        };
    };
    //#endif

