		qcom,charging_reset-gpio 		= <&tlmm 10 0x00>;		//check
		qcom,charging_clock-gpio 		= <&tlmm 121 0x00>;		//check
		qcom,charging_data-gpio 		= <&tlmm 122 0x00>;		//check
		qcom,vooc_asic_id-gpio			= <&tlmm 64 0x00>;
		qcom,vooc-max-input-volt-support = <10000>;     //10V
		qcom,vooc-max-input-current-support = <6500>;   //6A
		qcom,svooc_0_to_50_little_cold_stop_cur = <1000>;
		qcom,svooc_0_to_50_cold_stop_cur = <1000>;
		qcom,svooc_0_to_50_little_cool_stop_cur = <1100>;
		qcom,svooc_0_to_50_normal_low_stop_cur = <1100>;
		qcom,svooc_0_to_50_normal_high_stop_cur = <1300>;
		qcom,svooc_0_to_50_warm_stop_cur = <1300>;

		qcom,svooc_51_to_75_little_cold_stop_cur = <1000>;
		qcom,svooc_51_to_75_cold_stop_cur = <1000>;
		qcom,svooc_51_to_75_little_cool_stop_cur = <1000>;
		qcom,svooc_51_to_75_normal_low_stop_cur = <1100>;
		qcom,svooc_51_to_75_normal_high_stop_cur = <1300>;

		qcom,svooc_76_to_85_little_cold_stop_cur = <1000>;
		qcom,svooc_76_to_85_cold_stop_cur = <1000>;
		qcom,svooc_76_to_85_little_cool_stop_cur = <1000>;
		qcom,svooc_76_to_85_normal_low_stop_cur = <1100>;
		qcom,svooc_76_to_85_normal_high_stop_cur = <1300>;

		qcom,svooc_86_to_90_little_cold_stop_cur = <1000>;
		qcom,svooc_86_to_90_cold_stop_cur = <1000>;
		qcom,svooc_86_to_90_little_cool_stop_cur = <1000>;
		qcom,svooc_86_to_90_normal_low_stop_cur = <1100>;
		qcom,svooc_86_to_90_normal_high_stop_cur = <1300>;
		vooc_charge_strategy_30w {
			strategy_1 {
				capacity_range = <0 75>;
				temp_range = <120 160>;
				input_current = <4000 4450 0
						3000 4470 0
						2000 4480 0>;
            };
        
			strategy_2 {
				capacity_range = <0 75>;
				temp_range = <160 410>;
				input_current = <6000 4200 900
						5000 4200 0
						4500 4450 0
						4000 4450 0
						3000 4470 0
						2000 4480 0>;
			};

			strategy_3 {
				capacity_range = <0 75>;
				temp_range = <410 420>;
				input_current = <4000 4470 0
						2000 4480 0>;
			};

			strategy_4 {
				capacity_range = <0 75>;
				temp_range = <420 425>;
				input_current = <4000 4480 0>;
			};

			strategy_5 {
				capacity_range = <0 75>;
				temp_range = <425 435>;
				input_current = <3000 4480 0>;
			};
		};

		vooc_charge_strategy_65w {
			strategy_1 {
				capacity_range = <0 50>;
				temp_range = <120 160>;
				input_current = <6000 4200 0
						4000 4454 0
						2000 4494 0
						1500 4500 0>;
			};

			strategy_2 {
				capacity_range = <0 50>;
				temp_range = <160 370>;
				input_current = <6500 4200 0
						6000 4250 300
						5500 4300 400
						4500 4454 780
						3500 4454 0
						2000 4494 0
						1500 4500 0>;
			};

			strategy_3 {
				capacity_range = <0 90>;
				temp_range = <370 430>;
				input_current = <6500 4200 0
						6000 4250 300
						5500 4300 400
						4500 4454 780
						3500 4454 0
						2000 4494 0
						1600 4500 0>;
			};
		};

		svooc_charge_curve {
			strategy_soc_0_to_50 {
				strategy_temp_little_cold =	<4184 20 10 0
								 4424 15 10 0
								 4430 10 10 1>;
				strategy_temp_cool =		<4184 25 15 0
								 4424 20 10 0
								 4430 10 10 1>;
				strategy_temp_little_cool = 	<4184 50 35 0
								 4454 40 25 0
								 4484 30 11 0
								 4490 11 11 1>;
				strategy_temp_normal_low =	<4134 73 55 0
								 4184 60 45 0
								 4224 50 35 0
								 4454 40 25 0
								 4484 30 11 0
								 4490 11 11 1>;
				strategy_temp_normal_high =	<4134 73 55 0
								 4184 60 45 0
								 4224 50 35 0
								 4454 40 25 0
								 4484 30 13 0
								 4490 13 13 1>;
				strategy_temp_warm =	<4130 13 13 1>;
			};

			strategy_soc_50_to_75 {
				strategy_temp_little_cold =	<4424 15 10 0
								 4430 10 10 1>;
				strategy_temp_cool =		<4424 20 10 0
								 4430 10 10 1>;
				strategy_temp_little_cool =	<4454 40 25 0
								 4484 30 10 0
								 4490 10 10 1>;
				strategy_temp_normal_low =	<4454 40 25 0
								 4484 30 11 0
								 4490 11 11 1>;
				strategy_temp_normal_high =	<4224 45 35 0
								 4454 40 25 0
								 4484 30 13 0
								 4490 13 13 1>;
			};

			strategy_soc_75_to_85 {
				strategy_temp_little_cold = 	<4430 10 10 0>;
				strategy_temp_cool =		<4424 15 10 0
								 4430 10 10 1>;
				strategy_temp_little_cool =	<4484 25 10 0
								 4490 10 10 1>;
				strategy_temp_normal_low =	<4484 30 11 0
								 4490 11 11 1>;
				strategy_temp_normal_high =	<4484 30 13 0
								 4490 13 13 1>;
			};

			strategy_soc_85_to_90 {
				strategy_temp_little_cold = 	<4430 10 10 1>;
				strategy_temp_cool =		<4430 10 10 1>;
				strategy_temp_little_cool =	<4484 15 10 0
								 4490 10 10 1>;
				strategy_temp_normal_low =	<4484 20 11 0
								 4490 11 11 1>;
				strategy_temp_normal_high =	<4484 20 13 0
								 4490 13 13 1>;
			};
		};
	};

	stm8s_fastcg@26{
		status = "disabled";
		compatible = "oplus,stm8s-fastcg";
		reg = <0x26>;
		qcom,vooc-low-temp = <50>;
		qcom,oplus_batt_4400mv;
		qcom,support_vooc_by_normal_charger_path;
		qcom,vooc_fw_update_newmethod;
		qcom,vooc-high-temp = <430>;
		qcom,vooc-low-soc = <1>;
		qcom,vooc-high-soc = <90>;
		qcom,vooc-fw-type = <0x27>;//6A

		qcom,vooc_multistep_adjust_current_support;
		qcom,vooc_multistep_initial_batt_temp = <310>;
		qcom,vooc_strategy_normal_current = <0x06>;
		qcom,vooc-normal-to-little-cool-current = <0x05>;
		qcom,vooc_batt_over_high_temp = <440>;
		qcom,vooc_batt_over_low_temp = <45>;
		qcom,vooc_over_high_or_low_current = <0x0>;

		qcom,vooc_strategy1_batt_high_temp0 = <425>;
		qcom,vooc_strategy1_batt_high_temp1 = <430>;
		qcom,vooc_strategy1_batt_high_temp2 = <435>;
		qcom,vooc_strategy1_batt_low_temp2 = <420>;
		qcom,vooc_strategy1_batt_low_temp1 = <415>;
		qcom,vooc_strategy1_batt_low_temp0 = <400>;

		qcom,vooc_strategy1_high_current0 = <0x04>;//4A
		qcom,vooc_strategy1_high_current1 = <0x03>;//3A
		qcom,vooc_strategy1_high_current2 = <0x02>;//2A
		qcom,vooc_strategy1_low_current2 = <0x03>;//3A
		qcom,vooc_strategy1_low_current1 = <0x04>;//4A
		qcom,vooc_strategy1_low_current0 = <0x04>;//4A

		qcom,vooc_strategy2_batt_up_temp1 = <375>;
		qcom,vooc_strategy2_batt_up_down_temp2 = <380>;
		qcom,vooc_strategy2_batt_up_temp3 = <390>;
		qcom,vooc_strategy2_batt_up_down_temp4 = <400>;
		qcom,vooc_strategy2_batt_up_temp5 = <410>;
		qcom,vooc_strategy2_batt_up_temp6 = <415>;
		qcom,vooc_strategy2_high0_current = <0x05>;
		qcom,vooc_strategy2_high1_current = <0x04>;
		qcom,vooc_strategy2_high2_current = <0x03>;
		qcom,vooc_strategy2_high3_current = <0x02>;

		pinctrl-names = "switch1_act_switch2_act", "switch1_sleep_switch2_sleep",
						"switch1_act_switch3_act", "switch1_sleep_switch3_sleep",
						"switch1_act_switch2_sleep", "switch1_sleep_switch2_act",
						"clock_active","clock_sleep",
						"data_active","data_sleep",
						"reset_active","reset_sleep";
		pinctrl-0 = <&charging_switch1_active>;
		pinctrl-1 = <&charging_switch1_sleep >;
		pinctrl-2 = <&charging_switch1_active>;
		pinctrl-3 = <&charging_switch1_sleep >;
		pinctrl-4 = <&charging_switch1_active>;
		pinctrl-5 = <&charging_switch1_sleep>;
		pinctrl-6 = <&charging_clock_active >;
		pinctrl-7 = <&charging_clock_sleep >;
		pinctrl-8 = <&charging_data_active >;
		pinctrl-9 = <&charging_data_sleep >;
		pinctrl-10 = <&charging_reset_active >;
		pinctrl-11 = <&charging_reset_sleep >;

		qcom,charging_switch1-gpio = <&tlmm 82 0x00>;
		//qcom,charging_switch2-gpio = <&tlmm 113 0x00>;
		//qcom,charging_switch3-gpio = <&tlmm 38 0x00>;

		qcom,charging_reset-gpio = <&tlmm 10 0x00>;
		qcom,charging_clock-gpio = <&tlmm 131 0x00>;
		qcom,charging_data-gpio = <&tlmm 129 0x00>;
	};
};
