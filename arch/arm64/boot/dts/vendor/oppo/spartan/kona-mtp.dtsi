			pinctrl-7 = <&ccdetect_sleep>;
			pinctrl-8 = <&dischg_enable>;
			pinctrl-9 = <&dischg_disable>;
			pinctrl-10 = <&gpio1_adc_default>;
			pinctrl-11 = <&gpio8_adc_default>;
			pinctrl-12 = <&gpio5_adc_default>;
			pinctrl-13 = <&charger_int_default>;
			pinctrl-14 = <&input_pg_default>;

};
//#endif //OPLUS_FEATURE_CHG_BASIC

// kona.dtsi
&cnss_wlan_mem {
	size = <0x0 0x1400000>;
};

&wlan {
	qcom,sw-ctrl-gpio = <&tlmm 124 0>;
};

// kona-camera.dtsi
&soc {
    qcom,cam_smmu {
        msm_cam_smmu_icp {
            qcom,iommu-faults = "stall-disable", "non-fatal";
        };
    };
};

// kona-pinctrl.dtsi
&cam_sensor_mclk3_suspend {
	config {
		drive-strength = <6>;
	};
};

// kona-usb.dtsi
&usb2_phy0 {
	qcom,param-override-seq = <0x67 0x6c
							0x0a 0x70
							0x0a 0x74
							0x00 0x78>;
	qcom,param-override-seq-host = <0x67 0x6c
							0x0a 0x70
							0x0a 0x74
							0x00 0x78>;
};


&qupv3_se2_i2c {
	status = "ok";
	#include "../../qcom/pm8008.dtsi"
};

&pm8008_8 {
	/* PM8008 IRQ STAT */
	interrupt-parent = <&tlmm>;
	interrupts = <63 IRQ_TYPE_EDGE_RISING>;

	pinctrl-names = "default";
	pinctrl-0 = <&pm8008_active &pm8008_interrupt>;
};

&pm8008_regulators {
	vdd_l1_l2-supply = <&S8C>;
	vdd_l3_l4-supply = <&BOB>;
	vdd_l5-supply = <&S5A>;
	vdd_l6-supply = <&BOB>;
	vdd_l7-supply = <&BOB>;
};

&L1P {
	regulator-min-microvolt = <1050000>;
	regulator-max-microvolt = <1100000>;
	qcom,min-dropout-voltage = <10000>;
	qcom,hpm-min-load = <10000>;
};

&L2P {
	regulator-min-microvolt = <950000>;
	regulator-max-microvolt = <1100000>;
	qcom,min-dropout-voltage = <10000>;
	qcom,hpm-min-load = <10000>;
};

&L3P {
	regulator-min-microvolt = <2700000>;
	regulator-max-microvolt = <2800000>;
	qcom,min-dropout-voltage = <136000>;
	qcom,hpm-min-load = <10000>;
};

&L4P {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <2900000>;
	qcom,min-dropout-voltage = <160000>;
	qcom,hpm-min-load = <10000>;
};

&L5P {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	qcom,min-dropout-voltage = <100000>;
	qcom,hpm-min-load = <10000>;
};

&L6P {
	regulator-max-microvolt = <2900000>;
	qcom,min-dropout-voltage = <10000>;
	qcom,hpm-min-load = <10000>;
};

&L7P {
	regulator-max-microvolt = <2900000>;
	qcom,min-dropout-voltage = <10000>;
	qcom,hpm-min-load = <10000>;
};
